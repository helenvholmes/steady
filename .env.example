# Copy to .env.local. `npm run setup:env` writes one with fresh keys.

# Your time zone (IANA name, e.g. America/New_York). "Today" and notification times use it. Defaults to UTC.
STEADY_TIME_ZONE=

# Signs the session cookie and passkey challenges.
STEADY_SECRET=
# 32 random bytes, base64. Encrypts sensitive fields before they reach the database. Losing it loses the data.
STEADY_DATA_KEY=
# Required on a deployed host to register the first passkey (or a new device). Optional on localhost.
STEADY_SETUP_CODE=
# Local `next dev` only: 1 shows "Sign in without passkey" on /login (for browsers without your passkey).
# Ignored in production builds, on Vercel, and for any host other than localhost.
STEADY_DEV_LOGIN=

# Turso. Without these, the database is the SQLite file at data/steady.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Web push (VAPID). `npx web-push generate-vapid-keys` makes a pair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: address or https URL that push services can contact. Apple rejects localhost values.
VAPID_SUBJECT=

# Claude API, for AI progress weights (and completion highlights later). Without it, progress bars weight parts equally.
ANTHROPIC_API_KEY=

# cron-job.org calls /api/cron/tick every 5 minutes with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
